# Copy to .env (git-ignored: .gitignore covers .env and .env.*) and edit. Real environment variables win over this file.
# Precedence: command-line flag > environment variable > .env > default. Full list: src/kalmora/assistant/config.py

# --- development: a local Ollama --------------------------------------------------------------
KALMORA_AI_PROVIDER=ollama
KALMORA_AI_MODEL=qwen3:14b
KALMORA_AI_FAST_MODEL=qwen3:8b
# OLLAMA_HOST=127.0.0.1:11434
# KALMORA_OLLAMA_NUM_CTX=32768

# --- production: OpenAI -------------------------------------------------------------------------
# KALMORA_AI_PROVIDER=openai
# KALMORA_AI_MODEL=<model that answers mode deep>
# KALMORA_AI_FAST_MODEL=<model that answers mode fast>
# OPENAI_API_KEY=<your OpenAI key>
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- optional: explicit prices enable the USD cap per question and the cost in the traces -------
# KALMORA_AI_INPUT_USD_PER_MTOK=
# KALMORA_AI_OUTPUT_USD_PER_MTOK=
# KALMORA_AI_PRICE_SOURCE=<url and date of the tariff>

# KALMORA_MCP_URL=http://127.0.0.1:8010/mcp/
# KALMORA_CHAT_TRACE_DIR=outputs/chat
# KALMORA_CHAT_STORE_TEXT=true

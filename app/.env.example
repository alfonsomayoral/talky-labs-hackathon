# Local datasets served by the dev middleware (never committed). id:path relative to app/
KALMORA_DATASETS=dev:../../participant/phase_dev,test:../../participant-2/phase_test
# Folder with run bundles written by the backend (gitignored)
KALMORA_RUNS=../runs
# Backend API (optional): `kalmora serve` /v1. Lists its loaded phases and the runs with a bundle folder.
# VITE_API_URL=http://localhost:8000
# Chat backend for the Assistant (optional; the /v1 API has none)
# VITE_CHAT_URL=
# Assistant «Profundo» in development: the dev server calls OpenAI (Responses API). Server side only, never VITE_-prefixed.
# OPENAI_API_KEY=
# OPENAI_PROJECT_ID=
# OPENAI_MODEL=gpt-6-luna
